# ── Flask / App ──────────────────────────────────────────────────────────
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-secret-string
PORT=8000

# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/muraai_contracts
# Falls back to SQLite if DATABASE_URL is unset
AUTO_CREATE_TABLES=true
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600

# ── CORS ─────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Email (Resend) ───────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxx

# ── Email (SMTP fallback) ────────────────────────────────────────────────
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-smtp-password-or-app-password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ── Firebase Cloud Messaging ─────────────────────────────────────────────
FCM_SERVER_KEY=your-fcm-server-key

# ── JWT ──────────────────────────────────────────────────────────────────
JWT_EXPIRATION_HOURS=24

# ── Scheduler ────────────────────────────────────────────────────────────
# Only start the in-process scheduler in a dedicated single-worker process
# (see Procfile worker / scheduler service). Default false — web dynos must
# NOT run the scheduler or every cron job fires once per worker.
RUN_SCHEDULER=false

# Shared secret required by the /run-reminders cron endpoint (X-Cron-Secret header)
CRON_SECRET=change-me-to-a-long-random-string

# ── Microsoft 365 / Azure AD Integration ─────────────────────────────────
# Required for OneDrive, Outlook, Teams, and Entra ID providers.
# When absent, all Microsoft providers return no‑op stubs and the app
# continues to work without errors.
#
# 1. Create an App Registration in Azure Portal
# 2. Add the following API permissions:
#    - Files.ReadWrite.All   (OneDrive)
#    - Mail.Send              (Outlook)
#    - ChannelMessage.Send    (Teams)
#    - Team.ReadBasic.All     (Teams)
#    - Channel.ReadBasic.All  (Teams)
#    - User.Read.All          (Entra ID)
#    - GroupMember.Read.All   (Entra ID)
# 3. Grant admin consent for the permissions above
# 4. Create a client secret under Certificates & Secrets

AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# Per‑service feature flags (default: true when credentials exist)
ONEDRIVE_ENABLED=true
OUTLOOK_ENABLED=true
TEAMS_ENABLED=true
ENTRA_ENABLED=true

# Graph API endpoints (override for sovereign clouds)
GRAPH_API_ENDPOINT=https://graph.microsoft.com/v1.0
AZURE_AUTH_ENDPOINT=https://login.microsoftonline.com
